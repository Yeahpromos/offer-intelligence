{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm --prefix frontend run build",
  "installCommand": "npm ci && npm --prefix frontend ci",
  "outputDirectory": "public",
  "routes": [
    {
      "src": "^/api/ui/db/offer-performance/?$",
      "dest": "/api/db/index",
      "transforms": [{ "type": "request.headers", "op": "set", "target": { "key": "x-oi-db-route" }, "args": "ui-offer-performance" }]
    },
    {
      "src": "^/api/db/status/?$",
      "dest": "/api/db/index",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "x-oi-db-route" },
          "args": "status"
        }
      ]
    },
    {
      "src": "^/api/db/merchant/?$",
      "dest": "/api/db/index",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "x-oi-db-route" },
          "args": "merchant"
        }
      ]
    },
    {
      "src": "^/api/db/search/?$",
      "dest": "/api/db/index",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "x-oi-db-route" },
          "args": "search"
        }
      ]
    },
    {
      "src": "^/api/ui/db/status/?$",
      "dest": "/api/db/index",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "x-oi-db-route" },
          "args": "ui-status"
        }
      ]
    },
    {
      "src": "^/api/ui/db/merchant/?$",
      "dest": "/api/db/index",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "x-oi-db-route" },
          "args": "ui-merchant"
        }
      ]
    },
    {
      "src": "^/api/ui/db/search/?$",
      "dest": "/api/db/index",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "x-oi-db-route" },
          "args": "ui-search"
        }
      ]
    },
    {
      "src": "^/api/ui/db/keywords/?$",
      "dest": "/api/db/index",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "x-oi-db-route" },
          "args": "ui-keywords"
        }
      ]
    },
    {
      "src": "^/api/ui/db/offers/?$",
      "dest": "/api/db/index",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "x-oi-db-route" },
          "args": "ui-offers"
        }
      ]
    },
    {
      "src": "^/api/ui/db/tier_sheet/?$",
      "dest": "/api/db/index",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "x-oi-db-route" },
          "args": "ui-tier-sheet"
        }
      ]
    },
    {
      "src": "^/api/ui/db/tier-summary/?$",
      "dest": "/api/db/index",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "x-oi-db-route" },
          "args": "ui-tier-summary"
        }
      ]
    },
    {
      "src": "^/api/ui/db/tier1-merchants/?$",
      "dest": "/api/db/index",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "x-oi-db-route" },
          "args": "ui-tier1-merchants"
        }
      ]
    },
    {
      "src": "^/api/ui/db/monthly-new-merchants/?$",
      "dest": "/api/db/index",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "x-oi-db-route" },
          "args": "ui-monthly-new-merchants"
        }
      ]
    },
    {
      "src": "^/api/ui/db/publishers/?$",
      "dest": "/api/db/index",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "x-oi-db-route" },
          "args": "ui-publishers"
        }
      ]
    },
    {
      "src": "^/api/ui/db/brand-media-sankey/?$",
      "dest": "/api/db/index",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "x-oi-db-route" },
          "args": "ui-brand-media-sankey"
        }
      ]
    },
    {
      "src": "^/api/ui/db/brand-media-trend/?$",
      "dest": "/api/db/index",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "x-oi-db-route" },
          "args": "ui-brand-media-trend"
        }
      ]
    },
    {
      "src": "^/api/ui/db/google-ads-workbench/?$",
      "dest": "/api/db/index",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "x-oi-db-route" },
          "args": "ui-google-ads-workbench"
        }
      ]
    },
    {
      "src": "^/api/auth/login/?$",
      "dest": "/api/auth/index",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "x-oi-auth-route" },
          "args": "login"
        }
      ]
    },
    {
      "src": "^/api/auth/logout/?$",
      "dest": "/api/auth/index",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "x-oi-auth-route" },
          "args": "logout"
        }
      ]
    },
    {
      "src": "^/api/auth/session/?$",
      "dest": "/api/auth/index",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "x-oi-auth-route" },
          "args": "session"
        }
      ]
    },
    {
      "src": "^/api/copilotkit/?$",
      "dest": "/api/copilotkit/[...path]"
    },
    {
      "src": "^/api/copilotkit/(.*)$",
      "dest": "/api/copilotkit/[...path]"
    },
    {
      "src": "^/api/chat/classify/?$",
      "dest": "/api/chat/actions",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "x-oi-chat-route" },
          "args": "classify"
        }
      ]
    },
    {
      "src": "^/api/chat/analyze/?$",
      "dest": "/api/chat/actions",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "x-oi-chat-route" },
          "args": "analyze"
        }
      ]
    },
    {
      "src": "^/api/chat/agent/?$",
      "dest": "/api/chat/actions",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "x-oi-chat-route" },
          "args": "agent"
        }
      ]
    },
    {
      "src": "^/api/chat/agui/?$",
      "dest": "/api/chat/actions",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "x-oi-chat-route" },
          "args": "agui"
        }
      ]
    }
  ],
  "functions": {
    "api/auth/index.py": {
      "excludeFiles": "{.git/**,.github/**,data/**,docs/**,output/**,public/**,scripts/**,protected_data/**,*.md,*.txt,*.yml,init.sh,server.py}",
      "maxDuration": 60
    },
    "api/chat/actions.py": {
      "excludeFiles": "{.git/**,.github/**,data/**,docs/**,output/**,public/**,scripts/**,protected_data/**,*.md,*.txt,*.yml,init.sh,server.py}",
      "maxDuration": 60
    },
    "api/chat/stream.py": {
      "excludeFiles": "{.git/**,.github/**,data/**,docs/**,output/**,public/**,scripts/**,protected_data/**,*.md,*.txt,*.yml,init.sh,server.py}",
      "maxDuration": 60
    },
    "api/copilotkit/[...path].js": {
      "maxDuration": 60
    },
    "api/db/index.py": {
      "excludeFiles": "{.git/**,.github/**,data/**,docs/**,output/**,public/**,scripts/**,*.md,*.txt,*.yml,init.sh,server.py}",
      "includeFiles": "protected_data/**",
      "maxDuration": 60
    },
    "api/levanta/payments.py": {
      "excludeFiles": "{.git/**,.github/**,data/**,docs/**,output/**,public/**,scripts/**,protected_data/db_keywords_cache.json,protected_data/db_publishers_cache.json,*.md,*.txt,*.yml,init.sh,server.py}",
      "includeFiles": "protected_data/db_offers_cache.json",
      "maxDuration": 60
    },
    "api/tier_moves.py": {
      "excludeFiles": "{.git/**,.github/**,data/**,docs/**,output/**,public/**,scripts/**,protected_data/**,*.md,*.txt,*.yml,init.sh,server.py}",
      "maxDuration": 60
    }
  }
}
